# Copy this file to .env and insert your real Gemini API key below:
# GEMINI_API_KEY=AIzaSy...

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Mistral OCR API Key (Secondary AI Engine)
MISTRAL_API_KEY=
